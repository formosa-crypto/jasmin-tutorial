// Solution of the exercise in `matrix_optimized.jazz`: a translation of the
// assembly generated by `gcc -O3` for `multiply_matrices` (`matrix_O3_gcc13.s`).
// Variables are named after the registers GCC uses.
//
// The main differences with `matrix.jazz` are:
// - instead of recomputing `i * n + k` and `k * n + j` at each iteration, GCC
//   keeps pointers to the current elements of `a`, `b` and `c` and increments
//   them (by 8 bytes to move along a row, by `n * 8` bytes to move along a
//   column);
// - the loops are `do { ... } while (...)` loops (in Jasmin,
//   `while { ... } (cond)`), with a single test at the beginning (`n != 0`);
// - the memory operand of `imulq (%rcx), %rdx` saves a load into a register.
//
// The loop exits are slightly rearranged: GCC compares `j + 1` with `n` and
// only copies it to `j` (`movq %rax, %r10`) when it loops again, and exits the
// outer loop when `i == j` (both are then `n - 1`). In Jasmin we copy first and
// then compare with `n`, which is equivalent.
//
// Variable names are only names: Jasmin chooses the registers itself. Run
// `jasminc -pasm matrix_optimized.jazz` and compare its output with
// `matrixO3.s`.

export
fn multiply_matrices_optimized_jazz(reg u64 a b c n)
{
  reg u64 rax rbx rcx rdx rsi rdi rbp r8 r9 r10 r11 r12 r13;

  if (n != 0) {
    r11 = a;                       // movq    %rdi, %r11
    rdi = #LEA(n * 8);             // leaq    0(,%rcx,8), %rdi
    r13 = 0;                       // xorl    %r13d, %r13d      (i)
    r8 = #LEA(r11 + rdi);          // leaq    (%r11,%rdi), %r8  (end of row i of a)
    r12 = n;                       // movq    %rcx, %r12
    rbp = b;                       // movq    %rsi, %rbp
    rbx = c;                       // movq    %rdx, %rbx        (row i of c)
    while {                        // .L3:
      r9 = rbp;                    // movq    %rbp, %r9         (column j of b)
      r10 = 0;                     // xorl    %r10d, %r10d      (j)
      while {                      // .L6:
        rcx = r9;                  // movq    %r9, %rcx         (&b[k][j])
        rax = r11;                 // movq    %r11, %rax        (&a[i][k])
        rsi = 0;                   // xorl    %esi, %esi        (sum)
        while {                    // .L4:
          rdx = [rax];             // movq    (%rax), %rdx
          rdx *= [rcx];            // imulq   (%rcx), %rdx
          rax += 8;                // addq    $8, %rax
          rcx += rdi;              // addq    %rdi, %rcx
          rsi += rdx;              // addq    %rdx, %rsi
        } (r8 != rax)              // cmpq    %rax, %r8; jne .L4
        rax = #LEA(r10 + 1);       // leaq    1(%r10), %rax
        [rbx + r10 * 8] = rsi;     // movq    %rsi, (%rbx,%r10,8)
        r9 += 8;                   // addq    $8, %r9
        r10 = rax;                 // movq    %rax, %r10
      } (r10 != r12)               // cmpq    %rax, %r12; je .L5; jmp .L6
      rax = #LEA(r13 + 1);         // leaq    1(%r13), %rax
      rbx += rdi;                  // addq    %rdi, %rbx
      r11 += rdi;                  // addq    %rdi, %r11
      r8 += rdi;                   // addq    %rdi, %r8
      r13 = rax;                   // movq    %rax, %r13
    } (r13 != r12)                 // cmpq    %r10, %r13; je .L1; jmp .L3
  }
}
