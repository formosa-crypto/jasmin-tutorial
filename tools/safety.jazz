/* This file shows how to use the safety checker for Jasmin.
   Run `jasmin-checksafety --slice=<your function> safety.jazz` for every
   function here and see what the checker says about it.
   See https://jasmin-lang.readthedocs.io/en/latest/tools/safety.html for
   further information.

   Once we run the command we get either "No Safety Violation" or "Possible
   Safety Violation".
   For each violation, the checker will display the instruction which causes the
   violation and the reason, as follows:
   ```
   "safety.jazz", line [x]: [cause]
   ```

   The safety checker is incomplete: there are safe programs that will get
   rejected.
*/

/* This function reads an uninitialized value.
   The safety checker prints:
   ```
   *** Possible Safety Violation(s):
     "safety.jazz", line 33 (4-14): is_init x

   * Rel:
   ⊤
   ```
   The message `is_init x` indicates that `x` may not be initialized.
*/
export
fn uninitialized() -> reg u64 {
    reg u64 x;
    x = x + 1; // Uninitialized read from x.
    return x;
}

/* *** Possible Safety Violation(s):
     "safety.jazz", line 51 (4-14): y <>64 (64u) 0

   Memory ranges:
     mem_x: [0; 0]
     mem_y: [0; 0]

   * Rel:
   {inv_y ≥ 0, inv_x ≥ 0, inv_x ≤ 18446744073709551615, inv_y ≤ 18446744073709551615, mem_x = 0, mem_y = 0}
   mem_x ∊ [0; 0]
   mem_y ∊ [0; 0]
*/
export
fn arithmetic(reg u64 x y) -> reg u64 {
    x = x / y; // y could be zero.
    return x;
}

/* *** Possible Safety Violation(s):
     "safety.jazz", line 69 (4-13): in_bound: s[x] (length 8 U8)
     "safety.jazz", line 70 (4-13): is_init s[0]

   Memory ranges:
     mem_x: [0; 0]

   * Rel:
   {inv_x ≥ 0, inv_x ≤ 18446744073709551615, mem_x = 0}
   mem_x ∊ [0; 0]
*/
export
fn index(reg u64 x) -> reg u64 {
    stack u64[1] s;
    s[x] = 0; // x could be out of bounds.
    x = s[0]; // s[0] could be uninitialized
    return x;
}

/* *** No Safety Violation

   Memory ranges:
     mem_n: [0; 0]

   * Rel:
   {inv_n ≥ 0, inv_n ≤ 18446744073709551614, mem_n = 0}
   mem_n ∊ [0; 0]

   This loop does not terminate when n = 2^64-1.
   Older versions of Jasmin required programs to terminate and the safety
   checker reported a possible "termination" violation here. Since Jasmin
   2026.09, the semantics of Jasmin is based on interaction trees: the compiler
   also provides guarantees about non-terminating programs, so the safety
   checker no longer needs to prove termination.
*/
export
fn termination(reg u64 n) -> reg u64 {
    reg u64 i;
    i = 0;
    while (i <= n) { // n could be 2^64-1
        i += 1;
    }
    return i;
}

/* *** No Safety Violation

   Memory ranges:
     mem_p: [0; 8]

   * Rel:
   {inv_p ≥ 0, mem_p ≥ 0, mem_p ≤ 8, inv_p ≤ 18446744073709551615}
   mem_p ∊ [0; 8]

   * Alignment: p 64;

   This function does not have safety violations but `p` must be 64bit-aligned
*/
export
fn alignment(reg u64 p) {
    [#aligned :u64 p] = 0; // p needs to be 64bit-aligned.
}

// Write c to the first n bytes of p.
// Run with --param='memset>p;n'.
export
fn memset(reg u64 p, reg u8 c, reg u64 n) {
    reg u64 i;
    i = 0;
    while (i < n) {
        [:u8 p + i] = c; // 0 <= i < n
        i += 1;
    }
}
